# ---------------------------------------------------------------------------
# ShareDesk — configuration d'environnement (copier en .env, ne jamais commit)
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sharedesk
POSTGRES_USER=sharedesk_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_SSLMODE=require

# --- Backend ---
# Premier démarrage : aucun compte n'est créé automatiquement. Ouvrir
# l'interface web crée le premier compte administrateur via l'assistant de
# configuration initiale (tant qu'aucun utilisateur n'existe en base).
BACKEND_HTTP_ADDR=:8080
BACKEND_PUBLIC_URL=https://sharedesk.example.com

# JWT (access token courte durée) — 32+ octets aléatoires, ex: `openssl rand -base64 48`
JWT_SIGNING_SECRET=change-me-32-bytes-minimum-secret

# Clé de chiffrement applicatif AES-256-GCM (32 octets, base64) — `openssl rand -base64 32`
APP_ENCRYPTION_KEY=change-me-base64-32-bytes-key

# Mini-CA interne pour mTLS agents — mot de passe de la clé privée de la CA
CA_KEY_PASSPHRASE=change-me-ca-passphrase

# Durées de vie des tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- coturn (TURN/STUN) ---
TURN_REALM=sharedesk.local
TURN_SHARED_SECRET=change-me-turn-shared-secret
TURN_LISTEN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=49452

# --- Frontend ---
FRONTEND_API_BASE_URL=https://sharedesk.example.com/api/v1
FRONTEND_WS_BASE_URL=wss://sharedesk.example.com/api/v1

# --- Backend (listener mTLS agents) ---
BACKEND_AGENT_HOSTNAMES=sharedesk.example.com

# --- SMTP (notifications, optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sharedesk.example.com

# --- AD / LDAP (roadmap — configuration réelle faite depuis l'UI, pas ici) ---
# Le mot de passe du compte de service AD n'est JAMAIS stocké ici en usage normal :
# il est saisi dans l'UI admin et chiffré en base via APP_ENCRYPTION_KEY.
LDAP_ENABLED=false
